{
  "name": "magnes",
  "version": "0.1.0",
  "description": "An alternative web UI for bitmagnet",
  "scripts": {
    "build": "elm make src/Main.elm --output=public/main.js",
    "build:optimize": "elm make src/Main.elm --optimize --output=public/main.js",
    "dev": "npm run build && node dev.js",
    "format": "elm-format --yes src/*.elm src/Magnes/Api/ScalarCodecs.elm tests/*.elm",
    "test": "elm-test",
    "review": "elm-review",
    "test:e2e": "playwright test",
    "test:e2e:credentialed": "env MAGNES_E2E_CREDENTIALED=1 playwright test",
    "e2e:serve": "node e2e/harness/serve.js",
    "codegen": "elm-graphql ${BITMAGNET_URL:-http://localhost:3333}/graphql --base Magnes.Api --output src"
  },
  "license": "MIT",
  "devDependencies": {
    "@dillonkearns/elm-graphql": "^4.3.2",
    "@playwright/test": "^1.62.1",
    "elm": "^0.19.2-0",
    "elm-format": "^0.8.8",
    "elm-review": "^2.13.5",
    "elm-test": "^0.19.2-1"
  },
  "private": true
}
