type SelfQuery {
  identity: Self!
  passwordEntropy(password: String!): PasswordEntropyResult!
  apiKeys: [APIKey!]!
}

type SelfMutation {
  register(input: RegisterInput!): RegisterResult!
  login(username: String!, password: String!): LoginResult!
  loginBrowser(username: String!, password: String!): Void
  logoutBrowser: Void
  createAPIKey(input: CreateAPIKeyInput!): CreateAPIKeyResult!
  deleteAPIKey(id: Int!): Void
}

input RegisterInput {
  invitationCode: String
  username: String!
  password: String!
  email: String
}

input CreateAPIKeyInput {
  name: String!
  permissions: [AuthObjectActionInput!]!
  expiry: Duration
}

type CreateAPIKeyResult {
  id: Int!
  apiKey: String!
  name: String!
  expiresAt: DateTime
}

type Self {
  user: User
  apiKey: APIKey
  """
  The object actions this identity may exercise right now. For an API key that is
  its selected object actions, or the anonymous role's, narrowed by the owning
  user's role — because enforcement requires both, so this narrows when the role
  does. The selection itself stays visible on `apiKey.permissions`.
  """
  permissions: [AuthObjectAction!]!
}

type RegisterResult {
  user: User!
}

type LoginResult {
  token: String!
  user: User!
  permissions: [Permission!]!
}

type PasswordEntropyResult {
  entropy: Float!
  minEntropy: Float!
  valid: Boolean!
}
